# Copy this file to .env and fill in the values:  cp .env.example .env
# Never commit .env

# Required: signs session cookies. Generate one with:  openssl rand -hex 32
FLASK_SECRET_KEY=

# Required: PostgreSQL password, used by both the database and the app.
# Generate one with:  openssl rand -hex 16
# Note: the database only reads this on its first start. Changing it later
# does not change the password of an existing database volume.
DB_PASSWORD=

# Optional (defaults shown)
DB_NAME=bailiff
DB_USER=bailiff
APP_PORT=5000

# Which host interface the app port is published on.
# 127.0.0.1 = only this machine. 0.0.0.0 = every device on your network.
BIND_ADDRESS=127.0.0.1

# Optional: signed commercial license from the license issuer.
# Leave empty to use the 15-day evaluation trial.
PAYCHECK_SENTINEL_LICENSE=
