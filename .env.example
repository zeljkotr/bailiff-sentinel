# Copy this file to .env and fill in the values:  cp .env.example .env
# Never commit .env

# Required: signs session cookies. Generate one with:  openssl rand -hex 32
FLASK_SECRET_KEY=

# Required: PostgreSQL password (used by both the database and the app)
DB_PASSWORD=

# Optional (defaults shown)
DB_NAME=bailiff
DB_USER=bailiff
APP_PORT=5000
