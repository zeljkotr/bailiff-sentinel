[Unit]
# Developed by Zeljko Tripcevski
Description=paycheck-sentinel (bailiff-sentinel) web application
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
# Change User, Group and the paths below to match your server
User=zeljko
Group=zeljko
WorkingDirectory=/home/zeljko/bailiff-sentinel
EnvironmentFile=/home/zeljko/bailiff-sentinel/.env
ExecStart=/home/zeljko/bailiff-sentinel/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:5000 --timeout 120 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
